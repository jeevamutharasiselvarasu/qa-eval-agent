# Offline/locked-down alternative to python:3.13-slim, built FROM a debootstrap'd Ubuntu base (qa-base:noble).
# Only needed where Docker Hub is unreachable; see docker/local/README.md.
FROM qa-base:noble
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1
RUN echo "deb http://archive.ubuntu.com/ubuntu noble main universe" > /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates passwd \
    && ln -sf /usr/bin/python3 /usr/local/bin/python && rm -rf /var/lib/apt/lists/*
