# Copy this file to ".env" in the same folder (the project root). It is read automatically when the
# backend starts. Values already set in your shell take priority. Never commit .env.

# ---- Core
QA_ENV=dev                 # dev: no login needed (everyone is admin). prod: requires QA_AUTH_TOKENS
DATABASE_URL=              # empty = local SQLite file in QA_STORAGE_DIR. PostgreSQL example:
                           #   postgresql+psycopg://user:password@localhost:5432/qa_agent
QA_STORAGE_DIR=            # empty = backend/var/storage (uploads, outputs, evidence, reports)
QA_CORS_ORIGINS=http://localhost:5173

# ---- Login (only needed when QA_ENV=prod). Format: token:user:role:project1|project2  (roles: viewer|analyst|approver|admin)
QA_AUTH_TOKENS=

# ---- Jira (mock = built-in sample tickets DATA-1234 and SALES-77; cloud = your Jira Cloud site)
JIRA_MODE=mock
JIRA_BASE_URL=             # e.g. https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_AC_CUSTOM_FIELDS=     # e.g. customfield_10040
JIRA_TIMEOUT_S=20

# ---- AI provider (mock = offline deterministic helper; openai = any OpenAI-compatible endpoint)
LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ALLOW_DATA_SAMPLES=false   # false: record samples are never sent to the external model

# ---- Limits
QA_MAX_UPLOAD_BYTES=209715200
QA_SQL_TIMEOUT_S=60
QA_SQL_MEMORY_LIMIT=1GB
QA_PYTHON_TIMEOUT_S=60
QA_PYTHON_MEMORY_MB=1024
QA_VALIDATION_WORKERS=4
QA_SENSITIVE_COLUMNS=EMAIL,PHONE,SSN,PAN,AADHAAR,PASSWORD,DOB
