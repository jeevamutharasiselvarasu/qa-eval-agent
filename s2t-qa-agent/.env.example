# ---- Core
QA_ENV=dev                         # dev | test | prod  (prod requires QA_AUTH_TOKENS)
DATABASE_URL=postgresql+psycopg://qa:qa_password_change_me@db:5432/qa_agent   # empty => local SQLite
QA_STORAGE_DIR=/data/storage        # run-scoped uploads, outputs, evidence, reports
QA_CORS_ORIGINS=http://localhost:5173

# ---- Auth (token:user:role:project1|project2, roles viewer|analyst|approver|admin)
QA_AUTH_TOKENS=

# ---- Jira Cloud (JIRA_MODE=mock serves labelled fixtures from backend/fixtures/jira)
JIRA_MODE=mock
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_AC_CUSTOM_FIELDS=              # e.g. customfield_10040
JIRA_TIMEOUT_S=20

# ---- AI provider (LLM_MODE=mock uses deterministic offline heuristics)
LLM_MODE=mock                       # mock | openai (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ALLOW_DATA_SAMPLES=false        # if false, record samples are never sent to an external model

# ---- Limits
QA_MAX_UPLOAD_BYTES=209715200
QA_SQL_TIMEOUT_S=60
QA_SQL_MEMORY_LIMIT=1GB
QA_PYTHON_TIMEOUT_S=60
QA_PYTHON_MEMORY_MB=1024
QA_VALIDATION_WORKERS=4
QA_SENSITIVE_COLUMNS=EMAIL,PHONE,SSN,PAN,AADHAAR,PASSWORD,DOB

# ---- Ports (docker compose)
APP_PORT=8000                       # host port for the app; change if 8000 is already in use
